# Paste your Sentry DSN here. This key ships inside the app on purpose.
# Sentry → Settings → Projects → mess-monster → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Used only when EAS builds the Android app, so stack traces are readable.
# Leave blank until you create the Sentry project. Do not commit real tokens.
SENTRY_ORG=
SENTRY_PROJECT=mess-monster
SENTRY_AUTH_TOKEN=
